# =============================================================================
# ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================
# This file serves as a template for configuring security settings in the
# hello_world Node.js application. Copy this file to .env and customize
# the values for your deployment environment.
#
# Usage:
#   cp .env.example .env
#   # Edit .env with your specific values
#   npm start
#
# IMPORTANT: Never commit your actual .env file to version control!
# =============================================================================

# =============================================================================
# ENVIRONMENT MODE
# =============================================================================
# Determines the application's runtime environment.
# Options: development, production, test
#
# - development: Enables verbose logging, relaxed security for local testing
# - production: Strict security settings, optimized for deployment
# - test: Configuration for automated testing
#
# Required: No (defaults to 'development')
NODE_ENV=development

# =============================================================================
# SERVER PORTS
# =============================================================================
# Configure the ports for HTTP and HTTPS servers.
#
# HTTP_PORT: Port for the HTTP server
# - In production, HTTP requests are redirected to HTTPS
# - Default: 3000
# - Production recommendation: 80 (requires root privileges or reverse proxy)
#
# HTTPS_PORT: Port for the HTTPS (TLS/SSL) server
# - All secure traffic should use this port
# - Default: 3443
# - Production recommendation: 443 (requires root privileges or reverse proxy)
#
# Required: No (defaults provided)
HTTP_PORT=3000
HTTPS_PORT=3443

# =============================================================================
# RATE LIMITING CONFIGURATION
# =============================================================================
# Protects against brute-force attacks and DDoS by limiting requests per IP.
#
# RATE_LIMIT_WINDOW_MS: Time window for rate limiting in milliseconds
# - Default: 900000 (15 minutes)
# - Requests are counted within this sliding window
#
# RATE_LIMIT_MAX: Maximum number of requests allowed per window per IP address
# - Default: 100 requests per window
# - Exceeding this limit results in HTTP 429 (Too Many Requests)
#
# Production recommendations:
# - Adjust based on expected legitimate traffic patterns
# - Consider lower limits for authentication endpoints
# - Monitor and tune based on actual usage metrics
#
# Required: No (defaults provided)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# =============================================================================
# CORS (Cross-Origin Resource Sharing) CONFIGURATION
# =============================================================================
# Controls which domains can make cross-origin requests to your API.
#
# CORS_ORIGINS: Comma-separated list of allowed origins
# - Development: Typically localhost URLs
# - Production: Your actual domain(s)
#
# SECURITY WARNING:
# - Never use '*' (wildcard) in production - this allows any origin
# - Always specify exact origins for production deployments
# - Include protocol (http:// or https://) in origin URLs
#
# Examples:
#   Development: http://localhost:3000,http://localhost:8080
#   Production: https://example.com,https://app.example.com,https://admin.example.com
#
# Required: No (defaults to localhost for development)
CORS_ORIGINS=http://localhost:3000

# =============================================================================
# TLS/HTTPS CONFIGURATION
# =============================================================================
# SSL/TLS certificate configuration for HTTPS support.
#
# SSL_KEY_PATH: Path to the SSL private key file (.key)
# - Must be readable by the Node.js process
# - Keep private key secure with restricted file permissions (chmod 600)
#
# SSL_CERT_PATH: Path to the SSL certificate file (.cert or .pem)
# - For production, use certificates from a trusted Certificate Authority (CA)
# - For development, self-signed certificates are acceptable
#
# Certificate generation for development:
#   mkdir -p certs
#   openssl req -x509 -newkey rsa:4096 \
#     -keyout certs/server.key \
#     -out certs/server.cert \
#     -days 365 -nodes \
#     -subj "/CN=localhost"
#
# Production recommendations:
# - Use certificates from Let's Encrypt, DigiCert, or other trusted CAs
# - Set up automatic certificate renewal
# - Use absolute paths in production
#
# Required: Yes (for HTTPS functionality)
SSL_KEY_PATH=./certs/server.key
SSL_CERT_PATH=./certs/server.cert

# =============================================================================
# PROXY CONFIGURATION
# =============================================================================
# Configure trust settings when running behind a reverse proxy.
#
# TRUST_PROXY: Enable if running behind a reverse proxy (nginx, Apache, etc.)
# - When true: Express trusts X-Forwarded-* headers for IP detection
# - When false: Direct client IP is used for rate limiting
#
# Options: true, false, or specific proxy addresses
#
# IMPORTANT:
# - Set to 'true' when behind load balancers or reverse proxies
# - Required for accurate IP-based rate limiting behind proxies
# - Only enable if you trust your proxy infrastructure
#
# Required: No (defaults to false)
TRUST_PROXY=false

# =============================================================================
# ADDITIONAL NOTES
# =============================================================================
#
# SECURITY BEST PRACTICES:
# 1. Always use HTTPS in production
# 2. Set NODE_ENV=production in production environments
# 3. Use strong, CA-signed certificates for production
# 4. Regularly review and adjust rate limits based on traffic patterns
# 5. Keep CORS_ORIGINS as restrictive as possible
# 6. Store sensitive values in secure secret management systems
#
# DEPLOYMENT CHECKLIST:
# [ ] Set NODE_ENV=production
# [ ] Configure production-appropriate ports (80/443 or use reverse proxy)
# [ ] Install valid SSL certificates from trusted CA
# [ ] Set CORS_ORIGINS to production domains only
# [ ] Enable TRUST_PROXY if behind load balancer/reverse proxy
# [ ] Review rate limit settings for production traffic
# [ ] Ensure .env file has restricted permissions (chmod 600)
# [ ] Verify .env is in .gitignore
#
# For more information, see SECURITY.md in this repository.
# =============================================================================
