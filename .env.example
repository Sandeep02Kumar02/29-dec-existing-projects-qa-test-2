# Under PM2, the env / env_production blocks in ecosystem.config.js set these
# variables and override the values in this file.
#
# Server
PORT=3000
# HOST: 127.0.0.1 accepts local connections only; 0.0.0.0 accepts external connections.
HOST=127.0.0.1

# Application environment: development | production
NODE_ENV=development

# Winston log level: error | warn | info | http | verbose | debug | silly
LOG_LEVEL=info
